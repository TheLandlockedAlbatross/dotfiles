{
  // Extend the Quickshell Omarchy menu with JSONC.
  //
  // IDs are object keys. The parent is inferred from the dotted id, so
  // "personal.notes" appears under "personal", and "personal" appears on the
  // root menu. Reuse an existing id to override/extend it.
  //
  // Fields:
  //   icon        Nerd Font glyph shown in the icon column.
  //   label       Visible row title.
  //   action      Shell command to run. If omitted, the row is a submenu.
  //   target      Existing submenu id to open. Use for links/aliases.
  //   provider    Runtime provider function/command returning JSON rows.
  //   aliases     alternate `omarchy menu summon <name>` routes; also searchable.
  //   description Optional subtitle and extra search text.
  //   when        Shell condition; hide row when it fails.
  //   checked     Shell condition; append ✓ when it succeeds.
  //
  // Examples:
  // "personal": {"icon":"","label":"Personal"},
  // "personal.notes": {"icon":"󰎞","label":"Notes","action":"omarchy-launch-editor ~/notes"},
  // "personal.files": {"icon":"","label":"Files","action":"uwsm-app -- nautilus ~/Documents"},
  //
  // Only use provider when a provider_name function or command named "name"
  // returns JSON rows. Static submenus only need dotted ids.
  //
  // Example: replace the default About action by reusing the same id. Existing
  // fields are kept unless overridden.
  // "about": {"icon":"","label":"About","action":"omarchy-launch-or-focus-tui \"zsh -c 'fastfetch; read -k 1'\""},

  // fontget (~/.local/bin/fontget): sudo-less CUSTOM- installs from dafont.com,
  // 1001fonts.com or fontmeme.com into ~/.local/share/fonts/custom, same flow as
  // the stock Nerd Font rows next to them (floating presentation terminal +
  // gum). The second row only shows while some window title looks like a font
  // tab on one of those sites (fontmeme titles carry no host, just "… Font
  // Download"), and pre-fills from it.
  "install.style.font.fontget": {"icon":"","label":"From dafont / 1001fonts / fontmeme","aliases":["fontget","dafont","1001fonts","fontmeme"],"description":"Any dafont.com, 1001fonts.com or fontmeme.com font, installed for this user with the CUSTOM- prefix","action":"omarchy-launch-floating-terminal-with-presentation 'fontget install -i'"},
  "install.style.font.fontget-window": {"icon":"","label":"From the open font-site tab","when":"hyprctl clients -j | grep -qE '\\| dafont\\.com|· 1001 Fonts| Font Download'","action":"omarchy-launch-floating-terminal-with-presentation 'fontget install -i'"},
  "install.style.font.fontget-preview": {"icon":"󰈔","label":"Preview the open font-site tab","description":"Temp download, type your own text in a browser window, install from there","when":"hyprctl clients -j | grep -qE '\\| dafont\\.com|· 1001 Fonts| Font Download'","action":"omarchy-launch-floating-terminal-with-presentation 'fontget preview'"}
}
