      "link": null,
      "locked": false,
      "text": "STATE_FILE     ~/.local/state/omarchy/toggles/workspace-backgrounds\n                 persists across reboots\nCACHE_FILE     /tmp/hypr-workspace-bg-map\n                 10 lines; line N = background path for workspace N\nFRAME_DUR      /tmp/hypr-workspace-bg-framedur\n                 2 / max(refreshRate) \u2014 sync sleep in workspace-switch.sh\nCONF_FILE      ~/.config/omarchy/workspace-backgrounds.conf\n                 mode = default | odd-even | custom",
      "fontSize": 16.900000000000002,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "originalText": "STATE_FILE     ~/.local/state/omarchy/toggles/workspace-backgrounds\n                 persists across reboots\nCACHE_FILE     /tmp/hypr-workspace-bg-map\n                 10 lines; line N = background path for workspace N\nFRAME_DUR      /tmp/hypr-workspace-bg-framedur\n                 2 / max(refreshRate) \u2014 sync sleep in workspace-switch.sh\nCONF_FILE      ~/.config/omarchy/workspace-backgrounds.conf\n                 mode = default | odd-even | custom",
      "lineHeight": 1.35,
      "autoResize": true
    },
