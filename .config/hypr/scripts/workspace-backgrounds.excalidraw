      "updated": 1776361641351,
      "link": null,
      "locked": false,
      "text": "Cache build (build_cache)\n  theme   = cat ~/.config/omarchy/current/theme.name\n  sources = $omarchy/backgrounds/$theme/\n            $omarchy/current/theme/backgrounds/\n  default   \u2192 cycle sorted list across ws 1..10\n  odd-even  \u2192 odd= / even= filenames\n  custom    \u2192 custom_order= list, loops\nRebuild:  toggle-on,  startup (login),  theme-set hook",
      "fontSize": 16.900000000000002,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "originalText": "Cache build (build_cache)\n  theme   = cat ~/.config/omarchy/current/theme.name\n  sources = $omarchy/backgrounds/$theme/\n            $omarchy/current/theme/backgrounds/\n  default   \u2192 cycle sorted list across ws 1..10\n  odd-even  \u2192 odd= / even= filenames\n  custom    \u2192 custom_order= list, loops\nRebuild:  toggle-on,  startup (login),  theme-set hook",
      "lineHeight": 1.35,
      "autoResize": true
    },
