const css=FILES.map((f,i)=>`@font-face{font-family:"pv${i}";src:url(/font/${i});font-display:block}`).join("\n");
document.head.insertAdjacentHTML("beforeend",`<style>${css}</style>`);
const m=document.getElementById("m"),t=document.getElementById("t"),s=document.getElementById("s"),sv=document.getElementById("sv"),st=document.getElementById("status"),strip=document.getElementById("strip");
m.innerHTML=FILES.map((f,i)=>`<div class="style"><div class="name"><span>${f.name}</span><span>${f.size} · ${f.glyphs} glyphs</span></div><div class="sample" style="font-family:'pv${i}'"></div><div class="strip" style="font-family:'pv${i}'">${STRIP}</div></div>`).join("");
function render(){const v=t.value||t.placeholder;document.querySelectorAll(".sample").forEach(e=>{e.textContent=v;e.style.fontSize=s.value+"px"});document.querySelectorAll(".strip").forEach(e=>{e.style.fontSize=Math.max(14,s.value/2.5)+"px";e.style.display=strip.checked?"":"none"});sv.textContent=s.value}
t.oninput=render;s.oninput=render;strip.onchange=render;render();
document.getElementById("theme").onclick=()=>document.body.classList.toggle("light");
async function post(p){try{const r=await fetch(p,{method:"POST"});return await r.text()}catch(e){return ""}}
document.getElementById("install").onclick=async()=>{st.textContent="installing…";const r=await post("/install");st.textContent=r;document.getElementById("install").disabled=true};
document.getElementById("close").onclick=async()=>{await post("/close");window.close();st.textContent="closed — you can close this window."};
document.addEventListener("keydown",e=>{if(e.key==="Escape")document.getElementById("close").onclick()});
setInterval(()=>fetch("/ping").catch(()=>{}),1500);
</script>"""


def run_preview(meta: Font, files: list[Path], text_default: str, force: bool, keep_name: bool,
                open_browser: bool = True) -> list[tuple[str, str]]:
    """Serve the preview page on localhost until the page closes; returns what got installed."""
    state = {"last_ping": 0.0, "installed": [], "done": threading.Event()}
    file_meta = []
    for p in files:
        try:
            f = TTFont(str(p), lazy=True)
            fam = f["name"].getDebugName(1) or p.stem
            sub = f["name"].getDebugName(2) or ""
            glyphs = len(f.getGlyphOrder())
        except Exception:
            fam, sub, glyphs = p.stem, "", 0
        file_meta.append({"name": f"{fam} {sub}".strip() + f"  ({p.name})", "size": f"{p.stat().st_size // 1024} K", "glyphs": glyphs})
    lic = meta.license or "?"
    page = (PREVIEW_HTML.replace("__NAME__", htmlmod.escape(meta.name))
            .replace("__META__", htmlmod.escape(f"{SITE_IMPL[meta.site].name} · {meta.author} · {lic}"))
            .replace("__TEXT__", htmlmod.escape(text_default, quote=True))
            .replace("__FILES__", json.dumps(file_meta))).encode()

    class H(BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def _send(self, body: bytes, ctype="text/plain; charset=utf-8", code=200):
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            if self.path == "/":
                state["last_ping"] = time.time()
                self._send(page, "text/html; charset=utf-8")
            elif self.path == "/ping":
                state["last_ping"] = time.time()
                self._send(b"ok")
            elif m := re.fullmatch(r"/font/(\d+)", self.path):
                i = int(m.group(1))
                if i < len(files):
                    self._send(files[i].read_bytes(), "font/otf" if files[i].suffix.lower() == ".otf" else "font/ttf")
                else:
                    self._send(b"no", code=404)
            else:
                self._send(b"no", code=404)

        def do_POST(self):
            if self.path == "/install":
                try:
                    rows = install_files(files, force, keep_name)
                    state["installed"] = rows
                    msg = ("installed " + ", ".join(f"{f} → {fam or 'name kept'}" for f, fam in rows) + "\ninto " + str(FONT_DIR)
                           if rows else "nothing installed (already present? re-run with --force)")
                except Exception as e:  # surface it on the page instead of a dead button
                    msg = f"install failed: {e!r}"
                self._send(msg.encode())
            elif self.path == "/close":
                self._send(b"bye")
                state["done"].set()
            else:
                self._send(b"no", code=404)

    srv = ThreadingHTTPServer(("127.0.0.1", 0), H)
    srv.daemon_threads = True
    port = srv.server_address[1]
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    url = f"http://127.0.0.1:{port}/"
    con.print(f"preview: [bold]{url}[/bold]  [dim](type in the field; Install or Esc there, or Ctrl-C here)[/dim]")
    if open_browser:
        launcher = ["omarchy-launch-webapp", url] if shutil.which("omarchy-launch-webapp") else ["xdg-open", url]
        subprocess.Popen(launcher, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    started = time.time()
    try:
        while not state["done"].is_set():
            time.sleep(0.5)
            lp = state["last_ping"]
            if (lp and time.time() - lp > 6) or (not lp and time.time() - started > 120):
                break  # page gone (window closed) or browser never showed up
    except KeyboardInterrupt:
        pass
    srv.shutdown()
    # --app browser windows ignore window.close(); tidy the leftover window ourselves
    subprocess.run(["bash", "-c", "hyprctl clients -j | jq -r '.[] | select(.title|startswith(\"fontget · \")) | .address' | xargs -r -I{} hyprctl dispatch closewindow address:{}"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    return state["installed"]


# ------------------------------------------------------------------- install

@app.command()
def preview(
    font: FontArg = None,
    site: SiteOpt = "auto",
    sample: Annotated[str, typer.Option("--text", "-t", help="initial sample text")] = "The quick brown fox jumps over the lazy dog 0123456789",
    all_variants: Annotated[bool, typer.Option("--all", help="also show .ttf twins of .otf faces")] = False,
    keep_name: Annotated[bool, typer.Option("--keep-name", help="if installed from the page, keep the internal family name")] = False,
    force: Annotated[bool, typer.Option("--force", "-f", help="if installed from the page, overwrite existing files")] = False,
    no_browser: Annotated[bool, typer.Option("--no-browser", help="just print the URL")] = False,
):
    """Temp-download the font and open a page where you type text and see every style; Install from there."""
    s, slug = resolve(font, site)
    meta = SITE_IMPL[s].fetch(slug)
    con.print(f"[bold]{meta.name}[/bold] by {meta.author}  [dim]{SITE_IMPL[s].name} · {meta.category}[/dim]  {lic_markup(meta.license)}")
    with tempfile.TemporaryDirectory(prefix=f"fontget-{slug}-") as tmp:
        files = fetch_files(meta, Path(tmp), all_variants)
        rows = run_preview(meta, files, sample, force, keep_name, open_browser=not no_browser)
    if rows:
        record_provenance(meta, rows)
        report_installed(rows)
    else:
        con.print("[dim]preview closed, nothing installed[/dim]")


@app.command()
def install(
    font: FontArg = None,
    site: SiteOpt = "auto",
    all_variants: Annotated[bool, typer.Option("--all", help="keep both .otf and .ttf when a face ships as both (default: prefer .otf)")] = False,
    keep_name: Annotated[bool, typer.Option("--keep-name", help="only prefix the file name, leave the internal family name alone")] = False,
    force: Annotated[bool, typer.Option("--force", "-f", help="overwrite already-installed files")] = False,
    dry_run: Annotated[bool, typer.Option("--dry-run", "-n", help="download and show what would be installed, install nothing")] = False,
    interactive: Annotated[bool, typer.Option("--interactive", "-i", help="gum prompts (what the Omarchy menu and keybinding run)")] = False,
):
    """Download the zip to tmp, prefix everything with CUSTOM-, install for this user."""
    s, slug = resolve(font or (ask_font() if interactive else None), site)
    impl = SITE_IMPL[s]
    meta = impl.fetch(slug)  # the zip link can differ from the page slug (dafont bebas-neue → bebas_neue)
    want_preview = False
    if interactive:
        print_info(meta, note=False)
        if meta.note:
            con.print("[bold cyan]Note of the author[/bold cyan]  [dim](first lines)[/dim]")
            con.print("  " + "\n  ".join(l for l in meta.note.splitlines() if l.strip())[:600], highlight=False)
        con.print()
        choice = gum("choose", "--header", f"{meta.name} from {impl.name} ({meta.files} file(s)) as {PREFIX}… for this user:",
                     "Install", "Preview first (type your own text)", "Cancel")
        if choice.startswith("Cancel"):
            raise typer.Exit(CANCEL)
        want_preview = choice.startswith("Preview")
    else:
        con.print(f"[bold]{meta.name}[/bold] by {meta.author}  [dim]{impl.name} · {meta.category}[/dim]  {lic_markup(meta.license)}")
    with tempfile.TemporaryDirectory(prefix=f"fontget-{slug}-") as tmp:
        files = fetch_files(meta, Path(tmp), all_variants)
        if dry_run:
            for p in files:
                con.print(f"  would install {PREFIX}{p.name}  [dim]({p.stat().st_size // 1024} K)[/dim]")
            raise typer.Exit(0)
        if want_preview:
            rows = run_preview(meta, files, "The quick brown fox jumps over the lazy dog 0123456789", force, keep_name)
            if rows:
                record_provenance(meta, rows)
                report_installed(rows)
                return
            gum("confirm", f"Install {meta.name} anyway?")
        rows = install_files(files, force, keep_name)
    if not rows:
        raise typer.Exit(0)
    record_provenance(meta, rows)
    report_installed(rows)


@app.command("list")
def list_installed():
    """List the CUSTOM- fonts fontconfig can see (user dir and the old /usr/local one)."""
    out = subprocess.run(["fc-list", "--format", "%{file}\t%{family[0]}\t%{style[0]}\n"],
                         capture_output=True, text=True).stdout
    rows = sorted(l.split("\t") for l in out.splitlines() if f"/{PREFIX}" in l)
    t = Table(box=box.SIMPLE, padding=(0, 1))
    t.add_column("family", style="bold"); t.add_column("style"); t.add_column("file", style="dim")
    for file, fam, style in rows:
        t.add_row(fam, style, file.replace(str(Path.home()), "~"))
    con.print(t)


@app.command()
def remove(font: Annotated[str, typer.Argument(help="slug or any part of the file name")],
           yes: Annotated[bool, typer.Option("--yes", "-y")] = False):
    """Remove installed CUSTOM- files matching FONT from the user font dir."""
    needle = re.sub(r"[^a-z0-9]", "", slugify(font))
    hits = [p for p in FONT_DIR.glob(f"{PREFIX}*") if needle in re.sub(r"[^a-z0-9]", "", p.name.lower())]
    if not hits:
        con.print(f"nothing in {FONT_DIR} matches {font!r}")
        raise typer.Exit(1)
    for p in hits:
        con.print(f"  {p.name}")
    if yes or typer.confirm(f"remove {len(hits)} file(s)?"):
        for p in hits:
            p.unlink()
        subprocess.run(["fc-cache", "-f", str(FONT_DIR)], check=False)


@app.command("open")
def open_page(font: FontArg = None, site: SiteOpt = "auto"):
    """Open the font's page in the browser."""
    s, slug = resolve(font, site)
    subprocess.Popen(["xdg-open", SITE_IMPL[s].page_url(slug)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# ---------------------------------------------------------- manifest / sites

PROVENANCE = FONT_DIR / ".fontget.json"


def record_provenance(meta: Font, rows: list[tuple[str, str]]):
    try:
        data = json.loads(PROVENANCE.read_text()) if PROVENANCE.exists() else {}
    except ValueError:
        data = {}
    for file, _ in rows:
        data[file] = {"site": meta.site, "slug": meta.slug, "name": meta.name, "url": meta.url}
    PROVENANCE.write_text(json.dumps(data, indent=1, sort_keys=True))


@app.command()
def export():
    """Print a manifest of the installed CUSTOM- fonts this tool fetched: `site slug` per line."""
    if not PROVENANCE.exists():
        con.print("[dim]nothing recorded yet (only fonts installed by fontget are known)[/dim]")
        raise typer.Exit(1)
    seen = set()
    for file, p in sorted(json.loads(PROVENANCE.read_text()).items()):
        key = (p["site"], p["slug"])
        if key in seen or not (FONT_DIR / file).exists():
            continue
        seen.add(key)
        print(f"{p['site']} {p['slug']}  # {p['name']}")


@app.command("import")
def import_manifest(file: Annotated[Path, typer.Argument(help="manifest from `fontget export`")],
                    force: Annotated[bool, typer.Option("--force", "-f")] = False):
    """Install every `site slug` line of a manifest (sites must be enabled here)."""
    need_sites()
    for line in file.read_text().splitlines():
        line = line.split("#", 1)[0].strip()
        if not line:
            continue
        site, slug = line.split(None, 1)
        if site not in SITES:
            con.print(f"[yellow]skip[/yellow] {line}: site {site!r} not enabled")
            continue
        meta = SITE_IMPL[site].fetch(slug)
        with tempfile.TemporaryDirectory(prefix=f"fontget-{slug}-") as tmp:
            rows = install_files(fetch_files(meta, Path(tmp), False), force, False)
        record_provenance(meta, rows)
        report_installed(rows)


sites_app = typer.Typer(help="Which font sites this tool may fetch from. None are enabled until you say so.",
                        invoke_without_command=True, no_args_is_help=False)
app.add_typer(sites_app, name="sites")


@sites_app.callback()
def sites_list(ctx: typer.Context):
    """List available and enabled site adapters."""
    if ctx.invoked_subcommand:
        return
    enabled = {p.resolve(): p for p in SITES_ENABLED.glob("*.py")} if SITES_ENABLED.is_dir() else {}
    t = Table(box=box.SIMPLE, padding=(0, 1))
    t.add_column("site", style="bold"); t.add_column("state"); t.add_column("file", style="dim")
    for p in sorted(SITES_AVAILABLE.glob("*.py")):
        on = p.resolve() in enabled
        t.add_row(p.stem, "[green]enabled[/green]" if on else "[dim]available[/dim]", str(enabled[p.resolve()] if on else p).replace(str(Path.home()), "~"))
    for r, p in sorted(enabled.items(), key=lambda kv: kv[1].name):
        if SITES_AVAILABLE not in r.parents:
            t.add_row(p.stem, "[green]enabled[/green] (your own)", str(p).replace(str(Path.home()), "~"))
    con.print(t)
    con.print(f"[dim]lookup order: {', '.join(SITES) or '(none enabled)'}  ·  enable with `fontget sites enable NAME`[/dim]")


@sites_app.command("enable")
def sites_enable(name: Annotated[str, typer.Argument(help="adapter from sites-available, e.g. dafont")]):
    """Opt in to a site: link its adapter into ~/.config/fontget/sites/ (appended to the lookup order)."""
    src = SITES_AVAILABLE / f"{name}.py"
    if not src.exists():
        err.print(f"no adapter {name!r} in {SITES_AVAILABLE}")
        raise typer.Exit(1)
    SITES_ENABLED.mkdir(parents=True, exist_ok=True)
    if any(p.resolve() == src.resolve() for p in SITES_ENABLED.glob("*.py")):
        con.print(f"{name} already enabled")
        return
    n = 1 + max((int(m.group(1)) for p in SITES_ENABLED.glob("*.py") if (m := re.match(r"(\d+)-", p.name))), default=0)
    (SITES_ENABLED / f"{n:02d}-{name}.py").symlink_to(src)
    con.print(f"enabled {name} → you are choosing to fetch from that site under its terms")


@sites_app.command("disable")
def sites_disable(name: str):
    """Opt out again."""
    hits = [p for p in SITES_ENABLED.glob("*.py") if p.stem.split("-", 1)[-1] == name]
    if not hits:
        err.print(f"{name} is not enabled")
        raise typer.Exit(1)
    for p in hits:
        p.unlink()
    con.print(f"disabled {name}")


if __name__ == "__main__":
    try:
        app()
    except httpx.HTTPError as e:
        err.print(f"network error: {e}")
        sys.exit(1)
