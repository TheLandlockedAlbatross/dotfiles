#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# dependencies = ["httpx>=0.27", "selectolax>=0.3", "fonttools>=4.50", "typer>=0.12", "rich>=13"]
# ///
"""fontget — sudo-less font fetcher for Omarchy: preview and install fonts from font sites as CUSTOM-….

  fontget info [FONT] [-s SITE] [--siblings N]   what the site knows about it (+ category neighbours)
  fontget preview [FONT] [-s SITE] [--text T]    temp download + browser page: type text, see every style, Install button
  fontget install [FONT] [-s SITE] [-i] [-n]     download to tmp, CUSTOM- prefix, install to ~/.local/share/fonts/custom
  fontget search QUERY [-s SITE]                 search every enabled site + installed system fonts
  fontget category CAT [-s SITE] [--page N]      browse a site category
  fontget categories [-s SITE]                   category trees
  fontget list / remove FONT / open [FONT]       manage what's installed, open the page
  fontget export / import FILE                   manifest of installed fonts (site + slug per line) and replay it
  fontget sites [enable|disable NAME]            which font sites this tool may fetch from

No font site is configured out of the box.  Adapters for a few sites ship in
~/.config/fontget/sites-available/; `fontget sites enable NAME` is your own
decision to fetch from that site.  Enabled order = lookup order for bare names.

FONT is anything that names a font: "Sorean", "sorean", a font page or download
URL on an enabled site, or a browser window title.  With no FONT, the currently
open font-site Firefox window (via hyprctl) is used.  -s/--site pins one site.

Everything runs as the user: uv keeps the deps in its cache, fonts go to
~/.local/share/fonts/custom (fontconfig scans it automatically), fc-cache runs
on that directory only.  No root anywhere.
"""

from __future__ import annotations

import base64
import html as htmlmod
import json
import re
import shutil
import socket
import subprocess
import sys
import tempfile
import threading
import time
import zipfile
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from dataclasses import dataclass, field
from pathlib import Path
from typing import Annotated, Optional
from urllib.parse import urlparse, parse_qs

import httpx
import typer
from fontTools.ttLib import TTFont
from rich import box
from rich.console import Console
from rich.table import Table
from selectolax.lexbor import LexborHTMLParser as HTMLParser

UA = "Mozilla/5.0 (X11; Linux x86_64; rv:130.0) Gecko/20100101 Firefox/130.0"
PREFIX = "CUSTOM-"
FONT_DIR = Path.home() / ".local/share/fonts/custom"
FONT_EXT = {".ttf", ".otf", ".ttc"}
NAME_IDS = (1, 4, 6, 16, 21)  # family, full, postscript, typographic family, WWS family
CANCEL = 130  # omarchy-launch-floating-terminal-with-presentation skips "Done!" on 130



app = typer.Typer(add_completion=False, no_args_is_help=True, rich_markup_mode="rich",
                  pretty_exceptions_enable=False, help=__doc__.split("\n\n")[0])
con = Console()
err = Console(stderr=True, style="bold red")
client = httpx.Client(headers={"User-Agent": UA}, follow_redirects=True, timeout=30)

SiteOpt = Annotated[str, typer.Option("--site", "-s", help="an enabled site name, 'system', or auto (URL/window/lookup order decides)")]


def site_arg(site: str, allow_system: bool = False) -> str:
    """Validate -s; 'auto' when unset."""
    if site in ("auto", "") or (allow_system and site == "system") or site in SITES:
        return site or "auto"
    err.print(f"unknown site {site!r}; enabled: {', '.join(SITES) or 'none'} (see `fontget sites`)")
    raise typer.Exit(2)


def need_sites():
    if not SITES:
        err.print("no font site is enabled. This tool ships with none configured; opt in with\n"
                  "  fontget sites            # what is available\n"
                  "  fontget sites enable dafont")
        raise typer.Exit(2)


def text(node, default: str = "") -> str:
    return re.sub(r"\s+", " ", node.text()).strip() if node else default


def get(url: str, **params) -> HTMLParser:
    r = client.get(url, params=params or None)
    if r.status_code == 404:
        err.print(f"no page at {r.url}")
        raise typer.Exit(1)
    r.raise_for_status()
    return HTMLParser(r.text)


def free_license(lic: str) -> bool:
    l = lic.lower().strip()
    return (l.startswith("100%") or l == "free" or "domain" in l or "sil " in l or "ofl" in l
            or "commercial" in l and "personal" not in l)


def lic_markup(lic: str) -> str:
    return f"[{'green' if free_license(lic) else 'yellow'}]{lic}[/]"


# ---------------------------------------------------------------------- model

@dataclass
class Font:
    site: str
    slug: str
    name: str = ""
    author: str = ""
    author_url: str = ""
    category: str = ""          # human readable ("Fancy > Retro", "bold, retro, …")
    category_key: str = ""      # what `category` takes: dafont theme id or 1001fonts slug
    license: str = ""
    downloads: str = ""
    size: str = ""
    files: str = ""
    filenames: list[str] = field(default_factory=list)
    first_seen: str = ""
    glyphs: str = ""
    note: str = ""
    illustration: str = ""
    download: str = ""
    extra: dict[str, str] = field(default_factory=dict)

    @property
    def url(self) -> str:
        return SITE_IMPL[self.site].page_url(self.slug)


# ---------------------------------------------------------------- adapters

CONF_DIR = Path.home() / ".config/fontget"
SITES_ENABLED = CONF_DIR / "sites"             # what you opted in to (symlinks or your own files), lookup order = file order
SITES_AVAILABLE = CONF_DIR / "sites-available"  # shipped adapters, none active until enabled
SITES: dict[str, type] = {}


def load_sites():
    """Exec every enabled adapter file; each defines `class Site` (see the header of any shipped adapter)."""
    api = dict(Font=Font, text=text, get=get, client=client, con=con, err=err, Table=Table, box=box,
               HTMLParser=HTMLParser, typer=typer, re=re, json=json, base64=base64, htmlmod=htmlmod,
               urlparse=urlparse, parse_qs=parse_qs, Path=Path, SITES=SITES)
    for f in sorted(SITES_ENABLED.glob("*.py")) if SITES_ENABLED.is_dir() else []:
        ns = dict(api)
        try:
            exec(compile(f.read_text(), str(f), "exec"), ns)
            site = ns["Site"]
            SITES[site.name] = site
        except Exception as e:
            err.print(f"adapter {f.name} failed to load: {e!r}")


load_sites()
SITE_IMPL = SITES


# ------------------------------------------------------------------ resolving

def slugify(name: str) -> str:
    s = re.sub(r"\.(font|zip)$", "", name.strip(), flags=re.I)
    return re.sub(r"[^A-Za-z0-9]+", "-", s.lower()).strip("-")


def parse_ref(ref: str) -> tuple[str | None, str]:
    """(site, slug) for a URL, a window title, or a bare name (site None = unknown)."""
    s = ref.strip()
    if "://" in s or any(impl.owns(s) and "." in s.split()[0] for impl in SITE_IMPL.values()):
        u = urlparse(s if "://" in s else "https://" + s)
        for site, impl in SITE_IMPL.items():
            if impl.owns(u.netloc) and (slug := impl.slug_from_url(u)):
                return site, slug
    for site, impl in SITE_IMPL.items():
        if m := impl.title_re.match(s):
            return site, slugify(m.group(1))
    return None, slugify(s)


def window_refs() -> list[tuple[str, str]]:
    """Fonts open in browser windows, focused first."""
    try:
        clients = json.loads(subprocess.run(["hyprctl", "clients", "-j"], capture_output=True,
                                            text=True, check=True).stdout)
    except (OSError, subprocess.CalledProcessError, ValueError):
        return []
    clients.sort(key=lambda c: c.get("focusHistoryID", 99))
    out = []
    for c in clients:
        site, slug = parse_ref(c.get("title", ""))
        if site and slug:
            out.append((site, slug))
    return out


def find_slug(site: str, slug: str, quiet: bool = False) -> str | None:
    """Confirm a guessed slug exists on a site; otherwise try that site's search."""
    impl = SITE_IMPL[site]
    if impl.exists(slug):
        return slug
    want = re.sub(r"[^a-z0-9]", "", slug)
    hits, _ = impl.search(slug.replace("-", " "))
    for h in hits:
        if re.sub(r"[^a-z0-9]", "", h.name.lower()) == want:
            quiet or con.print(f"[dim]{slug} → [bold]{h.slug}[/bold] on {impl.name} (via search)[/dim]")
            return h.slug
    if len(hits) == 1:
        quiet or con.print(f"[dim]{slug} → [bold]{hits[0].slug}[/bold] on {impl.name} (only search hit)[/dim]")
        return hits[0].slug
    return None


def resolve(font: str | None, site: str) -> tuple[str, str]:
    need_sites()
    site = site_arg(site)
    if not font:
        refs = window_refs()
        if site != "auto":
            refs = [r for r in refs if r[0] == site]
        if not refs:
            err.print("no font given and no window of an enabled font site is open")
            raise typer.Exit(2)
        s, slug = refs[0]
        con.print(f"[dim]using open {SITE_IMPL[s].name} window → [bold]{slug}[/bold][/dim]")
        return s, slug
    s, slug = parse_ref(font)
    if s and site not in ("auto", s):
        err.print(f"{font!r} is a {SITE_IMPL[s].name} reference but --site {site} was given")
        raise typer.Exit(2)
    order = [s] if s else ([site] if site in SITES else list(SITES))
    for cand in order:
        if found := find_slug(cand, slug, quiet=len(order) > 1):
            if len(order) > 1 and (found != slug or cand != order[0]):
                con.print(f"[dim]{slug} → [bold]{found}[/bold] on {SITE_IMPL[cand].name}[/dim]")
            return cand, found
    err.print(f"no font {slug!r} on " + " or ".join(SITE_IMPL[c].name for c in order) + "; try `fontget search`")
    raise typer.Exit(1)


# ------------------------------------------------------------------- output

def print_info(f: Font, note: bool = True):
    impl = SITE_IMPL[f.site]
    t = Table(box=box.SIMPLE, show_header=False, padding=(0, 1))
    t.add_column(style="bold cyan", justify="right")
    t.add_column()
    t.add_row("font", f"[bold]{f.name}[/bold]  [dim]({f.slug} on {impl.name})[/dim]")
    t.add_row("author", f"{f.author}  [dim]{f.author_url}[/dim]")
    t.add_row("category", f"{f.category}  [dim]{f.category_key}[/dim]" if f.category else "?")
    t.add_row("license", lic_markup(f.license))
    if f.downloads:
        t.add_row("downloads", f.downloads)
    if f.first_seen:
        t.add_row("first seen", f.first_seen)
    if f.glyphs:
        t.add_row("glyphs", f.glyphs + "".join(f"  {k}={v}" for k, v in f.extra.items() if k in ("accents", "euro")))
    t.add_row("files", f"{f.files}{' (' + f.size + ')' if f.size else ''}: " + ", ".join(f.filenames))
    for k, v in f.extra.items():
        if k not in ("accents", "euro"):
            t.add_row(k, v)
    t.add_row("page", f.url)
    t.add_row("zip", f.download)
    if f.illustration:
        t.add_row("preview", f.illustration)
    con.print(t)
    if note and f.note:
        con.print("[bold cyan]Note of the author[/bold cyan]")
        con.print("  " + f.note.replace("\n", "\n  "), highlight=False)


def print_listing(fonts: list[Font], title: str = ""):
    t = Table(box=box.SIMPLE, padding=(0, 1), title=title or None, title_justify="left")
    for col in ("site", "slug", "name", "author", "category", "license", "downloads"):
        t.add_column(col, style="bold" if col == "slug" else None)
    for f in fonts:
        t.add_row(SITE_IMPL[f.site].name, f.slug, f.name, f.author, f.category, f.license, f.downloads.split(" (")[0])
    con.print(t)


def system_fonts(query: str) -> list[tuple[str, str, str]]:
    out = subprocess.run(["fc-list", "--format", "%{family[0]}\t%{style[0]}\t%{file}\n"],
                         capture_output=True, text=True).stdout
    q = re.sub(r"[^a-z0-9]", "", query.lower())
    rows = {}
    for line in out.splitlines():
        fam, style, file = (line.split("\t") + ["", ""])[:3]
        if q in re.sub(r"[^a-z0-9]", "", fam.lower()):
            rows.setdefault(fam, (fam, set(), file))[1].add(style)
    return sorted((fam, ", ".join(sorted(st)), file) for fam, st, file in rows.values())


# ------------------------------------------------------------ interactive

def gum(*args: str) -> str:
    """Run a gum widget; Esc/Ctrl-C cancels the whole flow like Omarchy's installers do."""
    r = subprocess.run(["gum", *args], stdout=subprocess.PIPE, text=True)  # UI is drawn on stderr, keep it on the tty
    if r.returncode != 0:
        raise typer.Exit(CANCEL)
    return r.stdout.strip()


def ask_font() -> str:
    need_sites()
    con.print(f"[green]Let's install a font from {', '.join(SITES)} as CUSTOM-… for this user.[/green]\n")
    args = ["input", "--prompt", "Font> ", "--placeholder", "name, slug or font page URL"]
    if refs := window_refs():
        args += ["--value", SITE_IMPL[refs[0][0]].page_url(refs[0][1])]
    return gum(*args) or (_ for _ in ()).throw(typer.Exit(CANCEL))


# ------------------------------------------------------------------ commands

FontArg = Annotated[Optional[str], typer.Argument(help="name, slug, URL or window title; default: open dafont/1001fonts window")]


@app.command()
def info(
    font: FontArg = None,
    site: SiteOpt = "auto",
    siblings: Annotated[int, typer.Option("--siblings", "-S", help="also list N fonts from the same category")] = 0,
    note: Annotated[bool, typer.Option("--note/--no-note", help="print the author's note")] = True,
    as_json: Annotated[bool, typer.Option("--json", help="machine-readable output")] = False,
):
    """Gather what the site knows about a font, using its category for context."""
    s, slug = resolve(font, site)
    f = SITE_IMPL[s].fetch(slug)
    if as_json:
        con.print_json(json.dumps({**f.__dict__, "url": f.url}))
        return
    print_info(f, note)
    if siblings and f.category_key:
        sibs = [x for x in SITE_IMPL[s].siblings(f) if x.slug != f.slug][:siblings]
        print_listing(sibs, f"More in {f.category.split(',')[0]} on {SITE_IMPL[s].name}")


@app.command()
def search(query: Annotated[str, typer.Argument(help="search terms")],
           site: SiteOpt = "auto", page: int = 1):
    """Search every enabled site and the fonts already installed on this system."""
    site = site_arg(site, allow_system=True)
    found_any = False
    for s in (list(SITES) if site == "auto" else ([site] if site in SITES else [])):
        try:
            fonts, total = SITE_IMPL[s].search(query, page)
        except typer.Exit:
            fonts, total = [], ""
        if fonts:
            found_any = True
            print_listing(fonts, f"{SITE_IMPL[s].name}  [dim]{total}{', page ' + str(page) if page > 1 or total else ''}[/dim]")
        else:
            con.print(f"[dim]{SITE_IMPL[s].name}: nothing[/dim]")
    if site in ("auto", "system"):
        rows = system_fonts(query)
        if rows:
            found_any = True
            t = Table(box=box.SIMPLE, padding=(0, 1), title="system fonts (fc-list)", title_justify="left")
            t.add_column("family", style="bold"); t.add_column("styles"); t.add_column("file", style="dim")
            for fam, styles, file in rows:
                t.add_row(fam, styles, file.replace(str(Path.home()), "~"))
            con.print(t)
        else:
            con.print("[dim]system: nothing[/dim]")
    if not found_any:
        raise typer.Exit(1)


@app.command()
def category(cat: Annotated[str, typer.Argument(help="site category: dafont id/name (115, retro), 1001fonts/fontmeme tag (retro, sans-serif)")],
             site: SiteOpt = "auto", page: int = 1):
    """Browse a category on one site (every enabled site when --site is auto)."""
    need_sites()
    site = site_arg(site)
    for s in (list(SITES) if site == "auto" else [site]):
        try:
            title, fonts = SITE_IMPL[s].category(cat, page)
        except typer.Exit:
            con.print(f"[dim]{SITE_IMPL[s].name}: no category {cat!r}[/dim]")
            continue
        print_listing(fonts, f"{SITE_IMPL[s].name}: {title}  [dim]page {page}[/dim]")


@app.command()
def categories(site: SiteOpt = "auto"):
    """Print the category trees of the enabled sites."""
    need_sites()
    site = site_arg(site)
    for s in (list(SITES) if site == "auto" else [site]):
        SITE_IMPL[s].print_categories()


def rewrite_names(path: Path, prefix: str) -> str:
    """Prefix the family-ish name records so the font shows up as CUSTOM-…; returns family."""
    fnt = TTFont(str(path))
    fam = ""
    for rec in fnt["name"].names:
        if rec.nameID not in NAME_IDS:
            continue
        s = rec.toUnicode().strip()
        if not s or s.startswith(prefix):
            continue
        rec.string = prefix + s
        if rec.nameID == 1 and not fam:
            fam = prefix + s
    if "CFF " in fnt:
        cff = fnt["CFF "].cff
        for n in list(cff.fontNames):
            if not n.startswith(prefix):
                cff.fontNames[cff.fontNames.index(n)] = prefix + n
    fnt.save(str(path))
    return fam


def fetch_files(meta: Font, tmpd: Path, all_variants: bool) -> list[Path]:
    """Download the site zip into tmpd and return the font files it holds (otf preferred over its ttf twin)."""
    zpath = tmpd / f"{meta.slug}.zip"
    with client.stream("GET", meta.download, headers={"Referer": meta.url}) as r:  # fontmeme insists on it
        with zpath.open("wb") as fh:
            for chunk in r.iter_bytes():
                fh.write(chunk)
    if not zipfile.is_zipfile(zpath):
        err.print(f"{meta.download} did not return a zip (HTTP {r.status_code}, {zpath.stat().st_size} bytes)")
        raise typer.Exit(1)
    con.print(f"[dim]downloaded {zpath.name} ({zpath.stat().st_size // 1024} K)[/dim]")
    with zipfile.ZipFile(zpath) as z:
        members = [m for m in z.namelist()
                   if Path(m).suffix.lower() in FONT_EXT
                   and not m.startswith("__MACOSX") and not Path(m).name.startswith(".")]
        z.extractall(tmpd / "x", members)
    files = [p for p in sorted((tmpd / "x").rglob("*")) if p.suffix.lower() in FONT_EXT]
    if not files:
        err.print("zip contained no .ttf/.otf/.ttc files")
        raise typer.Exit(1)
    if not all_variants:
        stems = {p.stem.lower() for p in files if p.suffix.lower() == ".otf"}
        files = [p for p in files if not (p.suffix.lower() == ".ttf" and p.stem.lower() in stems)]
    return files


def install_files(files: list[Path], force: bool, keep_name: bool) -> list[tuple[str, str]]:
    """Copy extracted font files into FONT_DIR as CUSTOM-…; returns (file, family) rows."""
    FONT_DIR.mkdir(parents=True, exist_ok=True)
    rows = []
    for p in files:
        dest = FONT_DIR / f"{PREFIX}{p.name}"
        if dest.exists() and not force:
            con.print(f"[yellow]exists, skipping[/yellow] {dest.name}  (use --force)")
            continue
        work = p.with_name(f"{PREFIX}{p.name}")  # keep the extracted original untouched (preview may still use it)
        shutil.copy2(p, work)
        fam = rewrite_names(work, PREFIX) if not keep_name else ""
        shutil.move(work, dest)
        rows.append((dest.name, fam))
    if rows:
        subprocess.run(["fc-cache", "-f", str(FONT_DIR)], check=False)
    return rows


def report_installed(rows: list[tuple[str, str]]):
    if not rows:
        return
    t = Table(box=box.SIMPLE, padding=(0, 1))
    t.add_column("installed", style="bold"); t.add_column("family")
    for r in rows:
        t.add_row(*r)
    con.print(t)
    fams = subprocess.run(["fc-list", "--format", "%{family[0]}\n"], capture_output=True, text=True).stdout
    con.print(f"[dim]fontconfig now knows {len({l for l in fams.splitlines() if l.startswith(PREFIX)})} {PREFIX} families[/dim]")


# ------------------------------------------------------------------- preview

