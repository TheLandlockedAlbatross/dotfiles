#!/usr/bin/env bash
# Walker menu for Bitwarden vault backup options

BIN_DIR="$HOME/.local/bin"

choice=$(printf '  Offline Password Backup (CLI)\n  Offline Password Backup (GUI)' \
  | omarchy-launch-walker --dmenu)

case "$choice" in
  *CLI*)
    omarchy-launch-floating-terminal-with-presentation "$BIN_DIR/bw-backup-cli"
    ;;
  *GUI*)
    omarchy-launch-floating-terminal-with-presentation "$BIN_DIR/bw-backup-gui"
    ;;
esac
